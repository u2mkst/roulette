{
  "name": "kst-roulette",
  "version": "1.0.0",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "^2.16.4",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "lint": "biome check --fix src/",
    "dev": "parcel index.html admin.html result.html --port 1235",
    "build": "yarn check:maps && parcel build index.html admin.html result.html --public-url / && cp assets/og-image.png dist/og-image.png",
    "simulate": "tsx scripts/simulate.ts",
    "probe": "tsx scripts/map-probe.ts",
    "check:maps": "tsx scripts/map-probe.ts all 30 1,2 --check"
  },
  "dependencies": {
    "box2d-wasm": "^7.0.0"
  }
}
